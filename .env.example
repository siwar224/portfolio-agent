# Copy this file to .env and fill in the values. Never commit .env.
# Each variable must appear only once (if repeated, the last line wins).

# Which model provider answers: "gemini" (free tier) or "anthropic" (paid).
# If empty: gemini when GEMINI_API_KEY is set, otherwise anthropic.
AGENT_PROVIDER=gemini

# Optional model id for the chosen provider. Leave empty for the default:
#   gemini    -> gemini-3.5-flash with low thinking (falls back to gemini-3.5-flash-lite)
#   anthropic -> claude-opus-5-5   (cheaper: claude-haiku-5-5)
AGENT_MODEL=

# Google Gemini key - free, from https://aistudio.google.com/apikey
# Free tier: Google may use prompts and answers to improve its products.
GEMINI_API_KEY=

# Anthropic Claude key - paid, from https://platform.claude.com
ANTHROPIC_API_KEY=
