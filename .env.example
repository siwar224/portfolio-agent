# Copy this file to .env and fill in the values. Never commit .env.

# Claude API key (https://platform.claude.com) - used from V1
ANTHROPIC_API_KEY=

# Model used by the agent - to confirm after the V1 eval
# claude-opus-5-5 (best quality) or claude-haiku-5-5 (much cheaper)
AGENT_MODEL=claude-opus-5-5
